generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String?
  createdAt DateTime @default(now())
}


model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String
  password String
  email    String @unique
}


